{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "llmff lifecycle event",
  "type": "object",
  "required": ["run_id", "event", "timestamp_ms"],
  "properties": {
    "run_id": { "type": "string" },
    "event": {
      "type": "string",
      "enum": [
        "run_started",
        "stage_started",
        "stage_finished",
        "run_finished",
        "run_failed"
      ]
    },
    "timestamp_ms": { "type": "integer", "minimum": 0 },
    "stage_id": { "type": "string" },
    "op": { "type": "string" },
    "status": { "type": "string" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "model": { "type": "string" },
    "backend": { "type": "string" },
    "provider_model": { "type": "string" },
    "prompt_tokens": { "type": "integer", "minimum": 0 },
    "completion_tokens": { "type": "integer", "minimum": 0 },
    "total_tokens": { "type": "integer", "minimum": 0 },
    "validation_errors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tool_kind": { "type": "string" },
    "tool_target": { "type": "string" },
    "output_path": { "type": "string" },
    "cache_hit": { "type": "boolean" },
    "cache_path": { "type": "string" },
    "failure_kind": {
      "enum": [
        "manifest_parse",
        "io",
        "json",
        "graph_validation",
        "unknown_stage",
        "timeout",
        "http",
        "stage_execution",
        "backend",
        "config",
        "not_implemented",
        "interrupted"
      ]
    },
    "failure_message": { "type": "string" }
  },
  "additionalProperties": true
}
