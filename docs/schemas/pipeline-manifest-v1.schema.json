{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llmff.dev/schemas/pipeline-manifest-v1.schema.json",
  "title": "llmff pipeline manifest v1",
  "type": "object",
  "required": ["version", "graph"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "inline_graph_syntax_version": { "const": 1 }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/input" }
    },
    "graph": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stage" }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/output" }
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "format": { "enum": ["text", "json"] }
      }
    },
    "output": {
      "type": "object",
      "required": ["from", "path"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "loop_break_on": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "stage"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "stage_success" },
            "stage": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["type", "stage"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "stage_failure" },
            "stage": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["type", "stage", "field"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "field_true" },
            "stage": { "type": "string", "minLength": 1 },
            "field": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["type", "stage", "field", "value"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "field_equals" },
            "stage": { "type": "string", "minLength": 1 },
            "field": { "type": "string", "minLength": 1 },
            "value": true
          }
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "never" }
          }
        }
      ]
    },
    "loop_final": {
      "type": "object",
      "required": ["from"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "require_status": { "enum": ["success", "invalid", "any"] }
      }
    },
    "stage": {
      "type": "object",
      "required": ["id", "op"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "op": { "type": "string", "minLength": 1 },
        "input": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "state_from": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "temperature": { "type": "number", "minimum": 0 },
        "top_p": { "type": "number", "minimum": 0, "maximum": 1 },
        "max_tokens": { "type": "integer", "minimum": 1 },
        "seed": { "type": "integer", "minimum": 0 },
        "response_format": { "type": "string", "minLength": 1 },
        "stop": { "type": "array", "items": { "type": "string" } },
        "sampler": { "type": "string", "minLength": 1 },
        "schema": { "type": "string", "minLength": 1 },
        "schema_path": { "type": "string", "minLength": 1 },
        "when": { "type": "string", "minLength": 1 },
        "on_success": { "type": "string", "minLength": 1 },
        "on_invalid": { "type": "string", "minLength": 1 },
        "on_skipped": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1 },
        "json_path": { "type": "string" },
        "mode": {
          "enum": [
            "truthy",
            "exists",
            "equals",
            "gt",
            "gte",
            "lt",
            "lte",
            "contains",
            "append",
            "extend",
            "merge_object",
            "first_success",
            "last_success",
            "highest_score",
            "field_max",
            "field_min"
          ]
        },
        "criteria": { "type": "string", "minLength": 1 },
        "score_field": { "type": "string", "minLength": 1 },
        "reason_field": { "type": "string", "minLength": 1 },
        "label_field": { "type": "string", "minLength": 1 },
        "min_score": { "type": "number" },
        "max_score": { "type": "number" },
        "value": true,
        "limit": { "type": "integer", "minimum": 1 },
        "dedupe_field": { "type": "string", "minLength": 1 },
        "initial_carry": {
          "type": "object",
          "additionalProperties": true
        },
        "items_from": { "type": "string", "minLength": 1 },
        "max_items": { "type": "integer", "minimum": 1 },
        "parallel": { "type": "boolean" },
        "max_concurrency": { "type": "integer", "minimum": 1 },
        "cases": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "default": { "type": "string", "minLength": 1 },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "transport": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "documents": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "top_k": { "type": "integer", "minimum": 1 },
        "strategy": { "enum": ["lexical", "embedding"] },
        "key": { "type": "string", "minLength": 1 },
        "index": { "type": "string", "minLength": 1 },
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "retry": {
          "type": "object",
          "required": ["attempts"],
          "additionalProperties": false,
          "properties": {
            "attempts": { "type": "integer", "minimum": 1 },
            "backoff_ms": { "type": "integer", "minimum": 0 }
          }
        },
        "cache_policy": { "enum": ["read", "refresh", "bypass"] },
        "max_iterations": { "type": "integer", "minimum": 1 },
        "break_on": { "$ref": "#/$defs/loop_break_on" },
        "carry": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "body": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stage" }
        },
        "final": { "$ref": "#/$defs/loop_final" },
        "on_iteration_error": { "enum": ["fail", "continue", "break"] },
        "retain_iterations": {
          "oneOf": [
            { "enum": ["none", "summaries", "all"] },
            {
              "type": "object",
              "required": ["mode"],
              "additionalProperties": false,
              "properties": {
                "mode": { "enum": ["none", "summaries", "all"] },
                "stages": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 },
                  "uniqueItems": true
                },
                "include_values": { "type": "boolean" }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "op": { "const": "extract" } },
            "required": ["op"]
          },
          "then": {
            "required": ["from"],
            "anyOf": [
              { "required": ["field"] },
              { "required": ["json_path"] }
            ]
          }
        },
        {
          "if": {
            "properties": { "op": { "const": "predicate" } },
            "required": ["op"]
          },
          "then": {
            "required": ["from"],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "mode": { "enum": ["equals", "gt", "gte", "lt", "lte"] }
                  },
                  "required": ["mode"]
                },
                "then": { "required": ["value"] }
              }
            ]
          }
        },
        {
          "if": {
            "properties": { "op": { "const": "score" } },
            "required": ["op"]
          },
          "then": {
            "required": ["from"],
            "anyOf": [
              { "required": ["score_field"] },
              { "required": ["field"] },
              { "required": ["json_path"] }
            ]
          }
        },
        {
          "if": {
            "properties": { "op": { "const": "select" } },
            "required": ["op"]
          },
          "then": {
            "required": ["from"],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "mode": { "enum": ["field_max", "field_min"] }
                  },
                  "required": ["mode"]
                },
                "then": {
                  "anyOf": [
                    { "required": ["field"] },
                    { "required": ["score_field"] }
                  ]
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": { "op": { "const": "map" } },
            "required": ["op"]
          },
          "then": {
            "required": ["from", "items_from", "max_items", "body"]
          }
        }
      ]
    }
  }
}
