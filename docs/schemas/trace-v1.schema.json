{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llmff.dev/schemas/trace-v1.schema.json",
  "title": "llmff trace event v1",
  "type": "object",
  "required": ["run_id", "event", "timestamp_ms"],
  "additionalProperties": false,
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "event": { "type": "string", "minLength": 1 },
    "stage_id": { "type": "string", "minLength": 1 },
    "loop_id": { "type": "string", "minLength": 1 },
    "loop_iteration": { "type": "integer", "minimum": 1 },
    "loop_stage_id": { "type": "string", "minLength": 1 },
    "map_id": { "type": "string", "minLength": 1 },
    "map_index": { "type": "integer", "minimum": 0 },
    "map_stage_id": { "type": "string", "minLength": 1 },
    "op": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "timestamp_ms": { "type": "integer", "minimum": 0 },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "attempts": { "type": "integer", "minimum": 1 },
    "model": { "type": "string", "minLength": 1 },
    "backend": { "type": "string", "minLength": 1 },
    "provider_model": { "type": "string", "minLength": 1 },
    "validation_errors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tool_kind": { "type": "string", "minLength": 1 },
    "tool_target": { "type": "string", "minLength": 1 },
    "output_path": { "type": "string", "minLength": 1 },
    "prompt_tokens": { "type": "integer", "minimum": 0 },
    "completion_tokens": { "type": "integer", "minimum": 0 },
    "total_tokens": { "type": "integer", "minimum": 0 },
    "cache_hit": { "type": "boolean" },
    "cache_path": { "type": "string", "minLength": 1 },
    "failure_kind": {
      "enum": [
        "manifest_parse",
        "io",
        "json",
        "graph_validation",
        "unknown_stage",
        "timeout",
        "http",
        "stage_execution",
        "backend",
        "config",
        "not_implemented",
        "interrupted"
      ]
    },
    "failure_message": { "type": "string", "minLength": 1 }
  }
}
