{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llmff.dev/schemas/plugin-manifest-v1.schema.json",
  "title": "llmff plugin manifest v1",
  "type": "object",
  "required": ["name", "version", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "name", "entrypoint"],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": ["backend", "sampler", "stage", "tool-transport"]
          },
          "name": { "type": "string", "minLength": 1 },
          "entrypoint": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
