{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/syndicalt/llmff/docs/schemas/inspect-report-v1.schema.json",
  "title": "llmff inspect report v1",
  "type": "object",
  "required": [
    "format_version",
    "manifest",
    "inputs",
    "outputs",
    "stage_order",
    "stages",
    "execution",
    "plugins"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "manifest": {
      "type": "object",
      "required": ["version", "source", "hash"],
      "properties": {
        "version": {
          "type": "integer"
        },
        "source": {
          "type": "object",
          "required": ["kind", "path", "cwd"],
          "properties": {
            "kind": {
              "enum": ["file", "inline_graph"]
            },
            "path": {
              "type": ["string", "null"]
            },
            "cwd": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": true
    },
    "inputs": {
      "type": "object"
    },
    "outputs": {
      "type": "object"
    },
    "stage_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "op", "model", "plugin", "writes_stdout"],
        "properties": {
          "id": {
            "type": "string"
          },
          "op": {
            "type": "string"
          },
          "input": {
            "type": ["string", "null"]
          },
          "from": {
            "type": ["string", "null"]
          },
          "model": {
            "type": ["object", "null"],
            "required": ["id", "alias", "provider_model"],
            "properties": {
              "id": {
                "type": "string"
              },
              "alias": {
                "type": "string"
              },
              "provider_model": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "sampler": {
            "type": ["string", "null"]
          },
          "plugin": {
            "type": ["object", "null"]
          },
          "cache_policy": {
            "type": ["string", "null"]
          },
          "timeout_ms": {
            "type": ["integer", "null"]
          },
          "retry": {
            "type": ["object", "null"]
          },
          "writes_stdout": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "execution": {
      "type": "object",
      "required": ["scheduler", "stdout"],
      "properties": {
        "scheduler": {
          "enum": ["sequential", "parallel"]
        },
        "max_concurrency": {
          "type": ["integer", "null"]
        },
        "default_timeout_ms": {
          "type": ["integer", "null"]
        },
        "default_retry": {
          "type": "object"
        },
        "checkpoint": {
          "type": "object"
        },
        "stdout": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "plugins": {
      "type": "object",
      "required": ["directories"],
      "properties": {
        "directories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
