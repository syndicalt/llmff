{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/syndicalt/llmff/docs/schemas/inspect-report-v1.schema.json",
  "title": "llmff inspect report v1",
  "type": "object",
  "required": [
    "format_version",
    "compatibility",
    "manifest",
    "inputs",
    "outputs",
    "stage_order",
    "stages",
    "execution",
    "backends",
    "plugins"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "compatibility": {
      "type": "object",
      "required": [
        "pipeline_manifest_schema",
        "inspect_report_schema",
        "inline_graph_syntax",
        "plugin_protocol"
      ],
      "properties": {
        "pipeline_manifest_schema": {
          "const": 1
        },
        "inspect_report_schema": {
          "const": 1
        },
        "inline_graph_syntax": {
          "const": 1
        },
        "plugin_protocol": {
          "const": 1
        }
      },
      "additionalProperties": true
    },
    "manifest": {
      "type": "object",
      "required": ["version", "source", "hash"],
      "properties": {
        "version": {
          "type": "integer"
        },
        "source": {
          "type": "object",
          "required": ["kind", "path", "cwd"],
          "properties": {
            "kind": {
              "enum": ["file", "inline_graph"]
            },
            "path": {
              "type": ["string", "null"]
            },
            "cwd": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": true
    },
    "inputs": {
      "type": "object"
    },
    "outputs": {
      "type": "object"
    },
    "stage_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "op",
          "model",
          "plugin",
          "capability_constraints",
          "writes_stdout"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "op": {
            "type": "string"
          },
          "input": {
            "type": ["string", "null"]
          },
          "from": {
            "type": ["string", "null"]
          },
          "model": {
            "type": ["object", "null"],
            "required": ["id", "alias", "provider_model"],
            "properties": {
              "id": {
                "type": "string"
              },
              "alias": {
                "type": "string"
              },
              "provider_model": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "sampler": {
            "type": ["string", "null"]
          },
          "plugin": {
            "type": ["object", "null"]
          },
          "capability_constraints": {
            "type": "object",
            "required": [
              "kind",
              "required_fields",
              "optional_fields",
              "capabilities"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "required_fields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "optional_fields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "plugin": {
                "type": "object"
              }
            },
            "additionalProperties": true
          },
          "cache_policy": {
            "type": ["string", "null"]
          },
          "timeout_ms": {
            "type": ["integer", "null"]
          },
          "retry": {
            "type": ["object", "null"]
          },
          "writes_stdout": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "execution": {
      "type": "object",
      "required": ["scheduler", "stdout"],
      "properties": {
        "scheduler": {
          "enum": ["sequential", "parallel"]
        },
        "max_concurrency": {
          "type": ["integer", "null"]
        },
        "default_timeout_ms": {
          "type": ["integer", "null"]
        },
        "default_retry": {
          "type": "object"
        },
        "checkpoint": {
          "type": "object"
        },
        "stdout": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "backends": {
      "type": "object",
      "required": ["registrations"],
      "properties": {
        "registrations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "kind",
              "source",
              "registration_flag",
              "base_url",
              "requires_api_key",
              "model_aliases",
              "capabilities"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "registration_flag": {
                "type": "string"
              },
              "base_url": {
                "type": ["string", "null"]
              },
              "requires_api_key": {
                "type": "boolean"
              },
              "model_aliases": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "plugins": {
      "type": "object",
      "required": ["directories", "protocol_version", "manifests"],
      "properties": {
        "directories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "protocol_version": {
          "const": 1
        },
        "manifests": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
