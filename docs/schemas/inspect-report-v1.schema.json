{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/syndicalt/llmff/docs/schemas/inspect-report-v1.schema.json",
  "title": "llmff inspect report v1",
  "type": "object",
  "required": [
    "format_version",
    "compatibility",
    "manifest",
    "inputs",
    "outputs",
    "stage_order",
    "stages",
    "execution",
    "backends",
    "plugins"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "compatibility": {
      "type": "object",
      "required": [
        "pipeline_manifest_schema",
        "inspect_report_schema",
        "inline_graph_syntax",
        "plugin_protocol"
      ],
      "properties": {
        "pipeline_manifest_schema": {
          "const": 1
        },
        "inspect_report_schema": {
          "const": 1
        },
        "inline_graph_syntax": {
          "const": 1
        },
        "plugin_protocol": {
          "const": 1
        }
      },
      "additionalProperties": true
    },
    "manifest": {
      "type": "object",
      "required": ["version", "source", "hash"],
      "properties": {
        "version": {
          "type": "integer"
        },
        "source": {
          "type": "object",
          "required": ["kind", "path", "cwd"],
          "properties": {
            "kind": {
              "enum": ["file", "inline_graph"]
            },
            "path": {
              "type": ["string", "null"]
            },
            "cwd": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": true
    },
    "inputs": {
      "type": "object"
    },
    "outputs": {
      "type": "object"
    },
    "stage_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "op",
          "model",
          "plugin",
          "capability_constraints",
          "loop",
          "writes_stdout"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "op": {
            "type": "string"
          },
          "input": {
            "type": ["string", "null"]
          },
          "from": {
            "type": ["string", "null"]
          },
          "model": {
            "type": ["object", "null"],
            "required": ["id", "alias", "provider_model"],
            "properties": {
              "id": {
                "type": "string"
              },
              "alias": {
                "type": "string"
              },
              "provider_model": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "sampler": {
            "type": ["string", "null"]
          },
          "plugin": {
            "type": ["object", "null"]
          },
          "capability_constraints": {
            "type": "object",
            "required": [
              "kind",
              "required_fields",
              "optional_fields",
              "capabilities"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "required_fields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "optional_fields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "plugin": {
                "type": "object"
              }
            },
            "additionalProperties": true
          },
          "loop": {
            "type": ["object", "null"],
            "required": [
              "max_iterations",
              "body_stage_count",
              "max_expanded_stage_count",
              "break_on",
              "final",
              "retain_iterations",
              "on_iteration_error"
            ],
            "properties": {
              "max_iterations": { "type": "integer", "minimum": 1 },
              "body_stage_count": { "type": "integer", "minimum": 1 },
              "max_expanded_stage_count": { "type": "integer", "minimum": 1 },
              "break_on": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": ["type", "stage"],
                    "properties": {
                      "type": { "const": "stage_success" },
                      "stage": { "type": "string" }
                    },
                    "additionalProperties": true
                  },
                  {
                    "type": "object",
                    "required": ["type", "stage"],
                    "properties": {
                      "type": { "const": "stage_failure" },
                      "stage": { "type": "string" }
                    },
                    "additionalProperties": true
                  },
                  {
                    "type": "object",
                    "required": ["type", "stage", "field"],
                    "properties": {
                      "type": { "const": "field_true" },
                      "stage": { "type": "string" },
                      "field": { "type": "string" }
                    },
                    "additionalProperties": true
                  },
                  {
                    "type": "object",
                    "required": ["type", "stage", "field", "value"],
                    "properties": {
                      "type": { "const": "field_equals" },
                      "stage": { "type": "string" },
                      "field": { "type": "string" },
                      "value": true
                    },
                    "additionalProperties": true
                  },
                  {
                    "type": "object",
                    "required": ["type"],
                    "properties": {
                      "type": { "const": "never" }
                    },
                    "additionalProperties": true
                  }
                ]
              },
              "final": {
                "type": ["object", "null"],
                "required": ["from"],
                "properties": {
                  "from": { "type": "string" },
                  "require_status": { "type": ["string", "null"] }
                },
                "additionalProperties": true
              },
              "retain_iterations": { "enum": ["none", "summaries", "all"] },
              "on_iteration_error": { "enum": ["fail", "continue", "break"] }
            },
            "additionalProperties": true
          },
          "cache_policy": {
            "type": ["string", "null"]
          },
          "timeout_ms": {
            "type": ["integer", "null"]
          },
          "retry": {
            "type": ["object", "null"]
          },
          "writes_stdout": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "execution": {
      "type": "object",
      "required": [
        "scheduler",
        "max_concurrency",
        "default_timeout_ms",
        "default_retry",
        "checkpoint",
        "stdout",
        "artifacts"
      ],
      "properties": {
        "scheduler": {
          "enum": ["sequential", "parallel"]
        },
        "max_concurrency": {
          "type": ["integer", "null"]
        },
        "default_timeout_ms": {
          "type": ["integer", "null"]
        },
        "default_retry": {
          "type": "object",
          "required": ["attempts", "backoff_ms"],
          "properties": {
            "attempts": {
              "type": "integer",
              "minimum": 1
            },
            "backoff_ms": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": true
        },
        "checkpoint": {
          "type": "object",
          "required": ["enabled", "resume", "path", "resume_path"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "resume": {
              "type": "boolean"
            },
            "path": {
              "type": ["string", "null"]
            },
            "resume_path": {
              "type": ["string", "null"]
            }
          },
          "additionalProperties": true
        },
        "stdout": {
          "type": "object",
          "required": ["events", "stream_stage", "manifest_outputs"],
          "properties": {
            "events": {
              "type": "boolean"
            },
            "stream_stage": {
              "type": "boolean"
            },
            "manifest_outputs": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "artifacts": {
          "type": "object",
          "required": ["trace", "events", "stream_stage"],
          "properties": {
            "trace": {
              "type": ["string", "null"]
            },
            "events": {
              "type": ["string", "null"]
            },
            "stream_stage": {
              "type": ["string", "null"]
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "backends": {
      "type": "object",
      "required": ["registrations"],
      "properties": {
        "registrations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "kind",
              "source",
              "registration_flag",
              "base_url",
              "requires_api_key",
              "model_aliases",
              "capabilities"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "registration_flag": {
                "type": "string"
              },
              "base_url": {
                "type": ["string", "null"]
              },
              "requires_api_key": {
                "type": "boolean"
              },
              "model_aliases": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "plugins": {
      "type": "object",
      "required": ["directories", "protocol_version", "manifests"],
      "properties": {
        "directories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "protocol_version": {
          "const": 1
        },
        "manifests": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
